<?xml version="1.0" encoding="utf-8"?><!--
   Правила извлечения данных для облака; при необходимости раскомментируйте и настройте.
   См. https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="calendar_visible_calendars.xml" />
        <exclude domain="sharedpref" path="calendar_bootstrap.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="calendar_visible_calendars.xml" />
        <exclude domain="sharedpref" path="calendar_bootstrap.xml" />
    </device-transfer>
</data-extraction-rules>
